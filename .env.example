# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Admin Dashboard Credentials
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_JWT_SECRET=your_jwt_secret_token

# Neon S3-Compatible Object Storage Credentials
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=portofolio
